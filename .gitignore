# Flask
instance/
.webassets-cache

# ===========================
# Variables de entorno
# CRITICO: nunca subir credenciales
# ===========================
.env
.env.*
*.env
backend/.env
!.env.example
!backend/.env.example

# ===========================
# Credenciales de la base de datos
# CRITICO: 07_credenciales.sql contiene las contrasenas de los roles.
# Solo se versiona la plantilla .example
# ===========================
database/07_credenciales.sql
!database/07_credenciales.sql.example

# ===========================
# Respaldos de la base de datos
# Contienen los hashes de contrasena de los usuarios: son sensibles
# ===========================
database/backup/*.sql
database/backup/*.dump
database/backup/*.backup
database/backup/*.tar
!database/backup/backup.bat
!database/backup/restaurar.bat
!database/backup/estrategia_respaldo.md
*.sqlite3
*.db

